# ---------------------------------------------------------------------------
# Secrets -- never commit these.
# The token file contains a live bearer token *and* the account's email
# address and OpenReview profile id, so it is both a credential leak and a
# privacy leak.
# ---------------------------------------------------------------------------
.openreview_token
.openreview_cookie
*.token
*.cookie

# Machine-specific Python location for the .exe launchers.
python-path.txt

# Raw API response cache and generated reports.
.cache/
results/
output/

# Generated launchers (rebuild with tools/build_exe.py).
*.exe
build/
dist/
*.spec

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
